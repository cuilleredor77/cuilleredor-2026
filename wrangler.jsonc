{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cuilleredor-2026",
  "account_id": "651db20122876c236858642c74c09c5d",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/*", "!/liseuse/*"]
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "MAIL_FROM": "Cuillère d’Or <contact@cuilleredor.fr>",
    "REVIEW_EMAIL": "cuilleredor4@gmail.com"
  },
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cuilleredor-devis",
      "database_id": "c25c78ae-40f0-4d51-9881-0d9738dad1d8",
      "migrations_dir": "migrations"
    }
  ]
}

